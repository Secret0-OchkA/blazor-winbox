@page "/docking"
@using Blazor.Winbox.Wasm.Windows

<PageTitle>Docking-Windows Usage</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 m-2">
    <button class="btn btn-primary" type="button" @onclick="OpenBlueWindow">Open blue window</button>
    <button class="btn btn-success" type="button" @onclick="OpenGreenWindow">Open green window</button>
    <button class="btn btn-outline-light" type="button" @onclick="OpenThreeBlueWindows">Open three blue windows</button>
    <span class="text-white-50">
        Drag or resize a window close to another window to dock it. Windows dock only to windows of the same group.
    </span>
</div>

@code {
    private const string BlueGroup = "blue";
    private const string GreenGroup = "green";

    [Inject] public IWindowManager WindowManager { get; set; }

    private int _openedWindows;

    private void OpenBlueWindow()
    {
        OpenWindow(BlueGroup, new WindowDockingOptions { Group = BlueGroup });
    }

    private void OpenGreenWindow()
    {
        OpenWindow(GreenGroup, new WindowDockingOptions
        {
            Group = GreenGroup,
            GuideColor = "#22c55e",
            GuideThickness = 2
        });
    }

    private void OpenThreeBlueWindows()
    {
        for (int i = 0; i < 3; i++)
        {
            OpenBlueWindow();
        }
    }

    private void OpenWindow(string group, WindowDockingOptions dockingOptions)
    {
        _openedWindows++;

        WindowOptions xWindowOptions = new()
        {
            Width = "380px",
            Height = "320px",
            X = $"{120 + (_openedWindows % 5) * 40}px",
            Y = $"{110 + (_openedWindows % 5) * 40}px",
            Icon = "./HITIcon.png",
            Docking = dockingOptions
        };

        WindowManager.Open<InfoWindow>($"{group} window {_openedWindows}", null, xWindowOptions);
    }
}
