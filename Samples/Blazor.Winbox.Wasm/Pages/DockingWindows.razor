@page "/docking"
@using Blazor.Winbox.Wasm.Windows

<PageTitle>Docking-Windows Usage</PageTitle>
<div class="input-group m-2" style="width: 349px; background-color:aqua;">
    <button @onclick="@OpenWindow" class="btn btn-outline-secondary" type="button" id="button-open">Open Window</button>

    <div id="dock-line-top" class="dock-line horizontal"></div>
    <div id="dock-line-bottom" class="dock-line horizontal"></div>
    <div id="dock-line-left" class="dock-line vertical"></div>
    <div id="dock-line-right" class="dock-line vertical"></div>
</div>

<style>
    .dock-line {
    position: absolute;
    background: rgba(0, 150, 255, 0.5);
    z-index: 9999;
    display: none;
    }

    .dock-line.vertical {
    width: 2px;
    height: 100vh;
    }

    .dock-line.horizontal {
    height: 2px;
    width: 100vw;
    }
</style>

@code {
    [Inject] public IWindowManager windowManager { get; set; }
    [Inject] IJSRuntime jSRuntime { get; init; } = null!;

    List<IWindowReference> windows = new();

    private async Task OpenWindow()
    {
        WindowOptions xWindowOptions = new() { Height = "400px", Width = "350px", Icon = "./HITIcon.png" };

        var parameters = new WindowParameters();
        //parameters.Add("OnMoveUp", (w,x,y) => {});

        var windowRef = windowManager.Open<InfoWindow>("info window", parameters, xWindowOptions);

        windowManager.Blur(windowRef.Id, true);
        windows.Add(windowRef);
    }

