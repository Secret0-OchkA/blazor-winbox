<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Version>0.2.14</Version>
    <Authors>Tameem Habash</Authors>
    <Company>HIT</Company>
    <Description>Blazor Multiple Windows Library that wraps winbox.js in Blazor components
</Description>
    <Title>Blazor Multiple Windows</Title>
    <Copyright>Copyright 2022 </Copyright>
    <PackageIcon>favicon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/TameemHabash/blazor-winbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>blazor multi window multiple windows winbox wasm client side</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReleaseNotes>Removed the internal members of BasicWindowOptions (Mount, handler names and the dotnet object reference) so window internals are no longer part of the public API. Added custom window toolbar buttons and customization of the built-in controls (Toolbar, Minimize, Maximize, Fullscreen, Close).</PackageReleaseNotes>
    <RootNamespace>BlazorWinbox</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="wwwroot\HITIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Docs\favicon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\BlazorWinbox.min.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>